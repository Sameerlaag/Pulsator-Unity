<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/plusor-menu.uss?fileID=7433441132597879392&amp;guid=b0af33da1dff93842a9bf692322166e4&amp;type=3#plusor-menu" />
    <ui:VisualElement name="background" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/MyAssets/Art/bg.png?fileID=2800000&amp;guid=df9d3a323e799b74a93860535fb5611b&amp;type=3#bg&quot;); -unity-background-scale-mode: stretch-to-fill; background-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: rgb(99, 101, 107); position: absolute; height: 100%; width: 100%;" />
    <ui:VisualElement name="MainContent" style="flex-grow: 1; padding-top: 64px; padding-right: 64px; padding-bottom: 64px; padding-left: 64px;">
        <ui:Label text="Synthwave Pulsor - alpha" name="Title" style="font-size: 76px; -unity-font-definition: url(&quot;project://database/Assets/HONETi/mobile_cartoon_GUI/Fonts/BerkshireSwash-Regular.ttf?fileID=12800000&amp;guid=65f60429d8edb1043bd905eab722146e&amp;type=3#BerkshireSwash-Regular&quot;); color: rgb(255, 245, 179); -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(255, 117, 0); -unity-font-style: bold-and-italic; text-shadow: 5.5px 3.5px 0 rgb(94, 0, 255); -unity-text-align: upper-center;" />
        <ui:VisualElement name="Options" style="flex-grow: 1; flex-direction: row;">
            <ui:VisualElement name="Buttons" style="flex-grow: 0; padding-top: 64px; padding-right: 32px; padding-bottom: 32px; padding-left: 32px;">
                <ui:Button text="Start" name="Start" class="menu-button" />
                <ui:Button text="Settings" name="Settings" class="menu-button" />
                <ui:Button text="Exit" name="Exit" class="menu-button" />
            </ui:VisualElement>
            <ui:VisualElement name="Pannel" style="flex-grow: 1;">
                <ui:VisualElement name="StartPanel" class="menu-panel">
                    <ui:ScrollView name="Songs" />
                    <ui:Label text="Default - easy" name="default" class="menu-item" />
                </ui:VisualElement>
                <ui:VisualElement name="SettingsPanel" style="flex-grow: 1;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
